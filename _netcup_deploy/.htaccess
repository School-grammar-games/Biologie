# =============================================
# EduBioSim.de - Apache Konfiguration
# =============================================

# --- HTTPS erzwingen ---
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- www. erzwingen (falls ohne www aufgerufen) ---
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

# --- Alte GitHub-Links weiterleiten ---
# Alte Hauptseite (DE) -> neue Startseite
RedirectMatch 301 ^/Biologie/Offizielle%20Webseite/Offizielle%20Webseite\.html$ /
RedirectMatch 301 ^/Biologie/Offizielle%20Webseite/Offizielle_Webseite_EN\.html$ /index_EN.html
RedirectMatch 301 ^/Biologie/?$ /
RedirectMatch 301 ^/Biologie/(.*)$ /$1

# --- Fehlerseiten ---
ErrorDocument 404 /index.html

# --- Sicherheitsheader ---
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# --- Cache fuer statische Dateien ---
<FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|mp4|mp3|woff2|woff|css|js)$">
  Header set Cache-Control "max-age=2592000, public"
</FilesMatch>
